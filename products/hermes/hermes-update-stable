#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${HERMES_REPO:-${HOME}/.hermes/hermes-agent}"
PATCH_SCRIPT="${HERMES_PATCH_SCRIPT:-${HOME}/.hermes/local-patches/products/hermes/reapply-patches.py}"
UV_BIN="${UV_BIN:-$(command -v uv || true)}"
PYTHON="${HERMES_PYTHON:-${REPO}/venv/bin/python}"
HERMES_HOME="${HERMES_HOME:-${HOME}/.hermes}"
HERMES_BIN="${HERMES_BIN:-${HOME}/.local/bin/hermes}"
DRY_RUN=0

usage() {
    cat <<'EOF'
Usage: hermes-update-stable [--plan] [vYYYY.M.D[.N]|latest]

Update Hermes to one explicit annotated release tag.
This command never follows main/trunk and never restores the old source-tree
stash automatically. The stash is kept for manual recovery or review.

Examples:
  hermes-update-stable --plan
  hermes-update-stable
  hermes-update-stable latest
  hermes-update-stable latest --plan
  hermes-update-stable --plan v2026.8.19
  hermes-update-stable v2026.8.19
EOF
}

TAG=""
for arg in "$@"; do
    case "$arg" in
        -h|--help)
            usage
            exit 0
            ;;
        --plan)
            DRY_RUN=1
            ;;
        latest|v*)
            if [[ -n "$TAG" ]]; then
                echo "Refusing multiple release targets: $TAG and $arg" >&2
                exit 2
            fi
            TAG="$arg"
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done
TAG="${TAG:-latest}"
if [[ "$TAG" != "latest" && ! "$TAG" =~ ^v[0-9]{4}\.[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Refusing non-release tag: $TAG" >&2
    exit 2
fi
if [[ ! -d "$REPO/.git" ]]; then
    echo "Hermes git checkout not found: $REPO" >&2
    exit 1
fi
if [[ ! -x "$PYTHON" ]]; then
    echo "Hermes Python interpreter not found: $PYTHON" >&2
    exit 1
fi
if [[ -z "$UV_BIN" || ! -x "$UV_BIN" ]]; then
    echo "uv executable not found; set UV_BIN explicitly" >&2
    exit 1
fi
if [[ ! -x "$PATCH_SCRIPT" ]]; then
    echo "Local patch reapply script not found: $PATCH_SCRIPT" >&2
    exit 1
fi

if [[ ! -x "$HERMES_BIN" ]]; then
    echo "Hermes entry point not found: $HERMES_BIN" >&2
    exit 1
fi

git_cmd() { git -C "$REPO" "$@"; }

if [[ "$TAG" == "latest" ]]; then
    TAG="$(
        git_cmd ls-remote --tags --refs origin "refs/tags/v*" |
            awk -F/ "{print \$3}" |
            grep -E "^v[0-9]{4}\.[0-9]+\.[0-9]+(\.[0-9]+)?\$" |
            sort -V |
            tail -n 1 || true
    )"
    if [[ -z "$TAG" ]]; then
        echo "Could not resolve the latest stable release tag from origin" >&2
        exit 1
    fi
    echo "Resolved latest stable release: $TAG"
fi

if ! git_cmd ls-remote --exit-code origin "refs/tags/${TAG}" >/dev/null 2>&1; then
    echo "Release tag does not exist on origin: $TAG" >&2
    exit 1
fi

CURRENT_REF="$(git_cmd symbolic-ref --short -q HEAD || git_cmd rev-parse --short HEAD)"
CURRENT_SHA="$(git_cmd rev-parse HEAD)"
echo "Current: $CURRENT_REF @ ${CURRENT_SHA:0:12}"
echo "Target:  $TAG"
echo "Remote:  $(git_cmd remote get-url origin)"
echo
echo "Current source-tree status:"
git_cmd status --short

if (( DRY_RUN )); then
    echo
    echo "Plan only: no fetch, checkout, dependency install, patching, or restart performed."
    exit 0
fi

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP_DIR="${HOME}/.hermes/backups"
mkdir -p "$BACKUP_DIR"
BACKUP_PATH="${BACKUP_DIR}/pre-stable-${TAG}-${STAMP}.zip"

echo
echo "==> Creating full Hermes state backup: $BACKUP_PATH"
"$HERMES_BIN" backup --output "$BACKUP_PATH"

STASH_REF=""
if [[ -n "$(git_cmd status --porcelain)" ]]; then
    STASH_MESSAGE="hermes-stable-update ${CURRENT_REF} -> ${TAG} ${STAMP}"
    echo "==> Parking all local checkout changes in git stash"
    git_cmd stash push --include-untracked --message "$STASH_MESSAGE"
    STASH_REF="$(git_cmd rev-parse refs/stash)"
    echo "    Kept as stash ${STASH_REF:0:12}: $STASH_MESSAGE"
else
    echo "==> Checkout is clean; no source-tree stash needed"
fi

GATEWAY_UNIT="hermes-gateway.service"
GATEWAY_WAS_ACTIVE=0
GATEWAY_MASKED=0
cleanup_gateway_mask() {
    if (( GATEWAY_MASKED )); then
        sudo -n systemctl unmask "$GATEWAY_UNIT" || true
        GATEWAY_MASKED=0
    fi
}
trap cleanup_gateway_mask EXIT
if sudo -n systemctl is-active --quiet "$GATEWAY_UNIT"; then
    GATEWAY_WAS_ACTIVE=1
    echo "==> Masking $GATEWAY_UNIT against Restart=always races"
    sudo -n systemctl mask --runtime "$GATEWAY_UNIT"
    GATEWAY_MASKED=1
    echo "==> Stopping $GATEWAY_UNIT before changing the live checkout"
    sudo -n systemctl stop "$GATEWAY_UNIT"
fi

refresh_system_gateway() {
    NODE_BIN_DIR=""
    NODE_BIN="$(command -v node || true)"
    if [[ -n "$NODE_BIN" ]]; then
        NODE_BIN_DIR="$(dirname "$(readlink -f "$NODE_BIN")")"
    fi
    SERVICE_PATH="${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    if [[ -n "$NODE_BIN_DIR" ]]; then
        SERVICE_PATH="${NODE_BIN_DIR}:${SERVICE_PATH}"
    fi
    sudo -n /usr/bin/env \
        "PATH=${SERVICE_PATH}" \
        "HERMES_HOME=${HERMES_HOME}" \
        "$HERMES_BIN" gateway restart --system
    if [[ -d "${HERMES_HOME}/backups/config" ]]; then
        # The root-only --system refresh can create one config snapshot as root;
        # the gateway itself runs as the invoking user and must be able to rotate it.
        RUN_UID="$(id -u)"
        RUN_GID="$(id -g)"
        sudo -n /usr/bin/chown -R "${RUN_UID}:${RUN_GID}" "${HERMES_HOME}/backups/config"
    fi
}

UPDATE_SUCCEEDED=0
finish() {
    local rc=$?
    if (( GATEWAY_MASKED )); then
        sudo -n systemctl unmask "$GATEWAY_UNIT" || true
        GATEWAY_MASKED=0
    fi
    if (( UPDATE_SUCCEEDED )); then
        if (( GATEWAY_WAS_ACTIVE )); then
            echo "==> Refreshing systemd unit and starting hermes-gateway"
            refresh_system_gateway
        fi
        echo "Stable update completed: $TAG"
        echo "Local source changes remain parked in ${STASH_REF:-no stash}."
    else
        echo "Update did not complete; gateway was left stopped for inspection." >&2
        echo "Previous ref: $CURRENT_REF @ ${CURRENT_SHA:0:12}" >&2
        echo "Backup: $BACKUP_PATH" >&2
        [[ -n "$STASH_REF" ]] && echo "Stash: $STASH_REF" >&2
    fi
    exit "$rc"
}
trap finish EXIT

echo "==> Fetching exact release tag"
git_cmd fetch --no-tags origin "refs/tags/${TAG}:refs/tags/${TAG}"
echo "==> Checking out detached release tag"
git_cmd switch --detach "$TAG"

echo "==> Installing dependencies into Hermes venv"
(
    cd "$REPO"
    "$UV_BIN" pip install --python "$PYTHON" --editable '.[all]'
)

echo "==> Reapplying Hermes-local patches"
"$PATCH_SCRIPT"

echo "==> Validating checkout"
"$PYTHON" -m compileall -q \
    "$REPO/hermes_cli" \
    "$REPO/plugins/platforms/telegram/adapter.py"
git_cmd diff --check
if ! CONFIG_STATUS="$("$HERMES_BIN" config check 2>&1)"; then
    printf "%s\n" "$CONFIG_STATUS" >&2
    echo "Config check failed; refusing to restart the gateway." >&2
    exit 1
fi
if printf "%s\n" "$CONFIG_STATUS" | grep -Eq "Config version:.*→|new config option"; then
    printf "%s\n" "$CONFIG_STATUS" >&2
    echo "Config migration is required; review and run hermes config migrate before restarting." >&2
    exit 1
fi

UPDATE_SUCCEEDED=1
