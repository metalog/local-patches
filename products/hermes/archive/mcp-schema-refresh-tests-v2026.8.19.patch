+    def test_stale_output_schema_refreshes_and_retries_once(self, _patch_mcp_server):
+        """A post-deploy outputSchema mismatch self-heals without a restart."""
+        session = _patch_mcp_server
+        session.call_tool = AsyncMock(
+            side_effect=[
+                RuntimeError(
+                    "Invalid structured content returned by tool my-tool: "
+                    "Additional properties are not allowed"
+                ),
+                _FakeCallToolResult(
+                    content=[_FakeContentBlock("recovered")],
+                    structuredContent={"new_field": True},
+                ),
+            ]
+        )
+        handler = mcp_tool._make_tool_handler("test-server", "my-tool", 30.0)
+
+        data = json.loads(handler({}))
+
+        assert data["result"] == "recovered"
+        assert data["structuredContent"] == {"new_field": True}
+        assert session.call_tool.await_count == 2
+        server = mcp_tool._servers["test-server"]
+        server._refresh_tools.assert_awaited_once()
+
+    def test_non_schema_runtime_error_is_not_retried(self, _patch_mcp_server):
+        session = _patch_mcp_server
+        session.call_tool = AsyncMock(side_effect=RuntimeError("other failure"))
+        handler = mcp_tool._make_tool_handler("test-server", "my-tool", 30.0)
+
+        data = json.loads(handler({}))
+
+        assert "other failure" in data["error"]
+        assert session.call_tool.await_count == 1
+        server = mcp_tool._servers["test-server"]
+        server._refresh_tools.assert_not_awaited()
+
+    def test_write_tool_schema_refresh_does_not_repeat_side_effect(self, _patch_mcp_server):
+        session = _patch_mcp_server
+        server = mcp_tool._servers["test-server"]
+        server._tools[0].annotations = SimpleNamespace(
+            readOnlyHint=False,
+            idempotentHint=False,
+        )
+        session.call_tool = AsyncMock(
+            side_effect=RuntimeError(
+                "Invalid structured content returned by tool my-tool: schema mismatch"
+            )
+        )
+        handler = mcp_tool._make_tool_handler("test-server", "my-tool", 30.0)
+
+        data = json.loads(handler({}))
+
+        assert "schema mismatch" in data["error"]
+        assert session.call_tool.await_count == 1
+        server._refresh_tools.assert_awaited_once()
