+def test_telegram_audio_document_is_audio_attachment():
+    """Telegram document uploads with audio MIME/extension should be exposed as audio attachments."""
+    from gateway.platforms.telegram import TelegramAdapter
+
+    msg = SimpleNamespace(
+        sticker=None,
+        photo=None,
+        video=None,
+        audio=None,
+        voice=None,
+        document=SimpleNamespace(file_name="20260619_161944.aac", mime_type="audio/aac"),
+    )
+
+    platform = TelegramAdapter.__new__(TelegramAdapter)
+
+    assert platform._media_message_type(msg) == MessageType.AUDIO
